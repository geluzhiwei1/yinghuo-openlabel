# CE (Community Edition) 环境变量
# 复制: cp env-templates/.env.ce.template .env.ce

# 数据卷挂载(宿主机路径)
YH_USER_DATA_ROOT=~/tmp/yh_ce_user_data
LOG_ROOT=~/tmp/yh_ce_logs
REDIS_DATA_DIR=~/tmp/yh_ce_redis_data
POSTGRES_DATA_DIR=~/tmp/yh_ce_postgres_data

# 端口映射(宿主 -> 容器)
WEB_APP_PORT=6600
WEB_API_PORT=6610

# 后端运行期敏感配置(Settings 通过 env_prefix='YH_' 读取)
# 生成: openssl rand -hex 32
YH_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
