{
    "openlabel": {
        "meta": {
            "name": "停车设施分类",
            "description": "日常驾驶中常见的停车设施分类",
            "version": "1.0.0",
            "license": "CCBY-SA 4.0",
            "copyright": "Copyright © 2024 openlabel.gerwee.com",
            "authors": [
                {"name": "Zhang Lizhi", "email": "gerwee@qq.com"}
            ],
            "contributors": [
            ]
        },
        "ontologies": {
            "0": "http://openlabel.gerwee.com/taxonomy/parking_1.0.0_zh-CN"
        },
        "classes": [
            {
                "name": "停车设施",
                "definition": {
                    "description": "日常停车时常见的设施"
                },
                "properties": {
                    "visibility": {
                        "type": "string",
                        "title": "可见性",
                        "description": "目标物体的可见程度",
                        "enum": [
                            "<40%",
                            "<60%",
                            "<80%",
                            "<=100%"
                        ],
                        "default": "unlabeled",
                        "ui:widget": "RadioWidget"
                    },
                    "tags": {
                        "type": "string",
                        "title": "标签",
                        "default": "",
                        "maxLength": 1024
                    },
                    "annotation": {
                        "type": "string",
                        "default": "",
                        "title": "描述",
                        "maxLength": 1024
                    }
                },
                "children": [
                    {
                        "name": "车位",
                        "definition": {
                            "description": "各类停车位"
                        },
                        "properties": {
                            "occupied": {
                                "type": "string",
                                "title": "是否有车",
                                "description": "是否已经停了车辆",
                                "enum": [
                                    "是",
                                    "否"
                                ],
                                "minLength": 1,
                                "default": "unlabeled",
                                "ui:widget": "RadioWidget"
                            },
                            "style": {
                                "type": "string",
                                "title": "车位排列方式",
                                "description": "车位跟车辆通行方向的关系",
                                "enum": [
                                    "平行式",
                                    "垂直式",
                                    "斜列式"
                                ],
                                "minLength": 1,
                                "default": "unlabeled",
                                "ui:widget": "RadioWidget"
                            },
                            "state": {
                                "type": "array",
                                "uniqueItems": true,
                                "title": "车位状态",
                                "description": "车位的更多情况描述",
                                "items": {
                                    "type": "string",
                                    "enum": [
                                        "无车位锁",
                                        "车位锁开（不能停）",
                                        "车位锁关（能停）",
                                        "充电车位",
                                        "小型车位",
                                        "大型车位",
                                        "被占用（锥桶、三角牌等）"
                                    ]
                                  },
                                "default": [],
                                "ui:widget": "CheckboxesWidget"
                            },
                            "text": {
                                "type": "string",
                                "title": "车位地面文字",
                                "description": "某些车位有文字说明，如女士车位、小型车位、残疾人车位、充电车位等",
                                "default": "",
                                "maxLength": 1024
                            },
                            "sign": {
                                "type": "string",
                                "title": "车位地面图形",
                                "description": "某些车位有图形",
                                "default": "",
                                "maxLength": 1024
                            },
                            "elevated": {
                                "type": "string",
                                "title": "升降车位",
                                "description": "是否是升降车位",
                                "enum": [
                                    "是",
                                    "否"
                                ],
                                "minLength": 1,
                                "default": "否",
                                "ui:widget": "RadioWidget"
                            }
                        }
                    },
                    {
                        "name": "停车场标识标线",
                        "definition": {
                            "description": "停车场常见标识标线"
                        },
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "分类",
                                "description": "停车场常见标识标线细分",
                                "enum": [
                                    "车道线",
                                    "楼层区域",
                                    "跨层标识",
                                    "闸口收费口标识",
                                    "停车位区域"
                                ],
                                "minLength": 1,
                                "default": "unlabeled",
                                "ui:widget": "RadioWidget"
                            }
                        }
                    },
                    {
                        "name": "停车场目标",
                        "definition": {
                            "description": "停车场目标分类"
                        },
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "分类",
                                "description": "停车场目标细分",
                                "enum": [
                                    "机动车",
                                    "非机动车",
                                    "行人",
                                    "锥桶",
                                    "水马",
                                    "收费口横杆",
                                    "轮档",
                                    "减速带",
                                    "地锁",
                                    "购物车",
                                    "杂物堆",
                                    "建筑"
                                ],
                                "minLength": 1,
                                "default": "unlabeled",
                                "ui:widget": "RadioWidget"
                            }
                        }
                    }
                ]
            }
        ]
    }
}