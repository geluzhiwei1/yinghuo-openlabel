# 后端运行期 .env 模板。
# 复制: cp .env.example .env
#
# 这个文件被 pydantic_settings 用 env_prefix='YH_' 读取,所以只有
# YH_ 开头的变量会被识别。其它(数据库/redis/mongo)统一走
# yinghuo.yaml(由 YH_CONFIG_FILE 指向),不要在这里塞。
#
# dev JWT 仅供本地开发,生产必须用强随机替换:
#   openssl rand -hex 32

# 必填,无默认值。长度 >= 32,启动期校验
YH_JWT_SECRET=replace-with-openssl-rand-hex-32

# 可选。生产应改为可信域逗号分隔(默认 * 不带 credential,本机开发够用)
# YH_CORS_ORIGINS=https://a.example.com,https://b.example.com

# 可选。/api/v1/p/* 平台面 IP 白名单,逗号分隔,生产必填
# YH_PLATFORM_ALLOWLIST=10.0.0.0/8,192.168.0.0/16

# 可选。Debug 模式,默认 false
# YH_DEBUG=true
